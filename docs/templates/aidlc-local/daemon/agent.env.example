# Agent-side variables → ~/.config/aidlc/agent.env (chmod 600). The daemon passes exactly these
# (plus PATH/HOME/locale and run context) to `opencode run`. Nothing else from the daemon's
# environment reaches the agent. A daemon secret here is refused.

# OpenAI-compatible base URL of your local runtime (Ollama :11434/v1, vLLM :8000/v1, LM Studio :1234/v1).
AIDLC_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Linear key for the bot member, content-scoped where Linear allows it (read, comments, Documents).
# A different key from AIDLC_LINEAR_DAEMON_KEY: revoking it stops agents, the daemon keeps working.
AIDLC_LINEAR_AGENT_KEY=

# GitHub token for the bot account: push + open/comment PRs. Branch protection must require a human
# review so this token cannot merge.
GH_TOKEN=
