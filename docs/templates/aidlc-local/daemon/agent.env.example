# Agent-side variables → ~/.config/aidlc/agent.env (chmod 600). The daemon passes exactly these
# (plus PATH/HOME/locale, run context, and the per-run Linear token AIDLC_LINEAR_AGENT_KEY) to
# `opencode run`. Nothing else from the daemon's environment reaches the agent. A daemon secret here
# is refused.

# OpenAI-compatible base URL of your local runtime (Ollama :11434/v1, vLLM :8000/v1, LM Studio :1234/v1).
AIDLC_LLM_BASE_URL=http://127.0.0.1:11434/v1

# GitHub token for the bot account: push + open/comment PRs. Branch protection must require a human
# review so this token cannot merge.
GH_TOKEN=

# Do NOT set AIDLC_LINEAR_AGENT_KEY here when the "AIDLC Agent" app is configured in daemon.env —
# the daemon mints it per run (read + comments only: it cannot move state or write Documents).
# (Static alternative only: a separate personal key, never the daemon's — but note a personal key
# is full-access, the pre-Decision-B model where the daemon detects and reverts any agent move.)
