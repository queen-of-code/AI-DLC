# AIDLC daemon secrets → ~/.config/aidlc/daemon.env (chmod 600). Read by the daemon only;
# never exported into a shell that runs `opencode`, and never passed to an agent process.
#
# Each NAME can instead be fetched by a command: NAME_CMD=... (e.g. from the macOS keychain):
#   security add-generic-password -a "$USER" -s aidlc-linear-daemon -w   # paste the key once
#   AIDLC_LINEAR_DAEMON_KEY_CMD=security find-generic-password -s aidlc-linear-daemon -w

# Full Linear key for the bot member: the only credential that moves workflow state.
AIDLC_LINEAR_DAEMON_KEY=

# Read-only GitHub token for the bot account (PR state, merge SHA, check conclusions).
AIDLC_GH_READ_TOKEN=

# Optional bearer token for the manual kick endpoint (kick.bind in config.jsonc).
AIDLC_KICK_TOKEN=
