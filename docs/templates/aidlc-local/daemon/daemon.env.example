# AIDLC daemon secrets → ~/.config/aidlc/daemon.env (chmod 600). Read by the daemon only;
# never exported into a shell that runs `opencode`, and never passed to an agent process.
#
# Each NAME can instead be fetched by a command: NAME_CMD=... (e.g. from the macOS keychain):
#   security add-generic-password -a "$USER" -s aidlc-daemon-secret -w   # paste the secret once
#   AIDLC_LINEAR_DAEMON_CLIENT_SECRET_CMD=security find-generic-password -s aidlc-daemon-secret -w
#
# Linear identities = two OAuth apps with "client credentials" enabled (OPENCODE-LOCAL.md → Linear apps).
# Linear only accepts an APP user as an issue's delegate, so the daemon must be an app, not a member seat.

# "AIDLC Daemon" app: the delegate (claim) and the only identity that moves workflow state.
AIDLC_LINEAR_DAEMON_CLIENT_ID=
AIDLC_LINEAR_DAEMON_CLIENT_SECRET=

# "AIDLC Agent" app: a separate app user, scoped read + comments only (Decision B): it cannot move
# state or write Documents. The daemon mints one token per run, hands it to that run as
# AIDLC_LINEAR_AGENT_KEY, and revokes it when the run ends. The run's Documents are written as lane
# files and published by the daemon. Agents never see these two values.
AIDLC_LINEAR_AGENT_CLIENT_ID=
AIDLC_LINEAR_AGENT_CLIENT_SECRET=

# Read-only GitHub token for the bot account (PR state, merge SHA, check conclusions).
AIDLC_GH_READ_TOKEN=

# Optional bearer token for the manual kick endpoint (kick.bind in config.jsonc).
AIDLC_KICK_TOKEN=

# Static alternative (not recommended): AIDLC_LINEAR_DAEMON_KEY=<key>. A member seat cannot be a
# delegate, so with a personal key the claim fails closed and nothing dispatches.
