# AIDLC local transport — environment (copy to wherever your shell or daemon loads env from;
# never commit real values). Design: feature/opencode-local/plan.md §3 in AI-DLC.
#
# Two principals, two sets of secrets. The agent process must never see the daemon's.

# ---------------------------------------------------------------------------
# AGENT process (`opencode` / `opencode run`) — export these and nothing else.
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL of your local runtime (Ollama :11434/v1, vLLM :8000/v1, LM Studio :1234/v1).
AIDLC_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Linear key for the bot member, scoped to content only (read, comments, Documents, issue create)
# where Linear allows it. It must NOT be the daemon key below — a separate key is your kill switch.
AIDLC_LINEAR_AGENT_KEY=

# GitHub token for the dedicated bot account: push + open/comment PRs. Branch protection must
# require a human review so this token cannot merge.
GH_TOKEN=

# ---------------------------------------------------------------------------
# DAEMON process only (P2) — never export these into an agent shell.
# ---------------------------------------------------------------------------

# Full Linear key for the same bot member: the only credential that moves workflow state.
AIDLC_LINEAR_DAEMON_KEY=

# Read-only GitHub token (PR state, merge SHA, check conclusions).
AIDLC_GH_READ_TOKEN=

# Optional: GitHub login of the bot account, checked by aidlc-doctor.sh.
AIDLC_GH_BOT_LOGIN=
